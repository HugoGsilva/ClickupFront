# ---------------------------------------------------------------------------
# ClickUp
# ---------------------------------------------------------------------------
# Token pessoal da API (ClickUp > Settings > Apps > API Token). Começa com "pk_".
CLICKUP_TOKEN=pk_00000000_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Id do time — o primeiro número da URL do ClickUp:
# https://app.clickup.com/9013302815/v/l/...
#                        ^^^^^^^^^^
# Usado só pelo "npm run descobrir", que lista os ids de espaços, pastas e listas.
CLICKUP_TEAM_ID=

# ESCOPO: preencha UM dos dois.
#
# A pasta inteira (a "Negócios Precatório"):
CLICKUP_FOLDER_ID=
#
# ...ou listas específicas, separadas por vírgula:
CLICKUP_LIST_IDS=
#
# Em CLICKUP_LIST_IDS você pode colar o id que aparece na URL do ClickUp
# (o "8ckr5gz-2173" de .../v/l/8ckr5gz-2173): aquilo é o id da VIEW, e o app
# resolve sozinho até a lista. Se preferir os ids diretos, ou se quiser ver
# tudo que existe, rode "npm run descobrir".

# Quais tarefas entram na exportação
CLICKUP_INCLUDE_CLOSED=true      # inclui tarefas fechadas/concluídas
CLICKUP_INCLUDE_SUBTASKS=true    # inclui subtarefas
CLICKUP_INCLUDE_ARCHIVED=false   # inclui listas e tarefas arquivadas

# ---------------------------------------------------------------------------
# Basic Auth (login do navegador)
# ---------------------------------------------------------------------------
AUTH_USER=admin
# Use uma senha longa e aleatória: é a única coisa entre a internet e os dados.
AUTH_PASSWORD=troque-esta-senha

# Freio de força bruta. Cada erro do mesmo IP dobra o atraso da resposta e,
# passando do limite, o IP leva 429 por um tempo. Os padrões servem bem.
AUTH_MAX_FAILURES=20      # falhas até bloquear o IP
AUTH_BLOCK_SECONDS=300    # duração do bloqueio
AUTH_WINDOW_SECONDS=900   # janela em que as falhas são contadas

# Ligue APENAS se houver um proxy reverso de confiança na frente (Traefik,
# Nginx, Cloudflare). Com isso o app passa a usar o X-Forwarded-For para
# identificar o cliente — exposto direto, qualquer um forja esse cabeçalho e
# escapa do freio.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000
APP_TITLE=Negócios Precatório
LISTS_CACHE_SECONDS=60     # cache da listagem de nomes
EXPORT_CACHE_SECONDS=300   # rebaixar a mesma lista dentro desse tempo sai na hora
TZ=America/Sao_Paulo       # fuso usado nas datas da planilha
